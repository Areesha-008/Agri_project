# Compose-level build args (read by docker-compose.yml's variable
# substitution — distinct from backend/.env and frontend/.env.local, which
# are each read directly by their own service).
#
# Copy to .env before running `docker compose build` / `docker compose up`.

# Mapbox access token, baked into the frontend's client bundle at build
# time (see frontend/Dockerfile). Sign up (free tier) at
# https://account.mapbox.com/ — same value as frontend/.env.local's
# NEXT_PUBLIC_MAP_TILES_KEY.
NEXT_PUBLIC_MAP_TILES_KEY=
